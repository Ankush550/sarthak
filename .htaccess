# ============================================================
# SarthakYojana.in – .htaccess (Speed + HSTS + CSP + Security)
# ============================================================

# ── HSTS (HTTP Strict Transport Security) ───────────────────
# This ACTIVATES HSTS - fixes "HSTS Status: Inactive"
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── Force HTTPS (required for HSTS to work) ─────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── CSP Header (fixes "CSP Protection: Missing") ────────────
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com;"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── GZIP Compression (60-80% size reduction = faster load) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ── Browser Caching ─────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 1 hour"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType application/json         "access plus 1 hour"
  ExpiresDefault                         "access plus 1 week"
</IfModule>

# ── Cache-Control ───────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|woff|png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Keep-Alive ──────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# ── WWW to non-WWW ──────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} ^www\.sarthakyojana\.in [NC]
  RewriteRule ^(.*)$ https://sarthakyojana.in/$1 [L,R=301]
</IfModule>

# ── 404 Handler ─────────────────────────────────────────────
ErrorDocument 404 /index.html

# ── Security: Block sensitive files ─────────────────────────
<FilesMatch "(\.htaccess|\.htpasswd|\.env|\.git|composer\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>
